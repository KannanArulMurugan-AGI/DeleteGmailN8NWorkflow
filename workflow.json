        "options": {}
      },
      "id": "e0b1f2c3-d4e5-4f6a-8b9c-0d1e2f3a4b5c",
      "name": "Gmail (Read for AI)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 3,
      "position": [
        1000,
        200
      ],
      "credentials": {
        "gmailApi": {
          "id": "YOUR_GMAIL_CREDENTIALS_ID",
          "name": "Gmail credentials"
        }
      }
    },
    {
      "parameters": {
        "model": "gemini-pro",
        "prompt": "You are an email classifier. Your task is to determine if an email is related to banking. Bank-related emails contain words like \"bank\", \"account statement\", \"transaction alert\", \"credit card\", \"payment\", \"invoice\", \"receipt\", etc.\n\nAnalyze the following email content and subject. Respond with only a JSON object with a single key \"decision\" which can be either \"DELETE\" or \"KEEP\". Do not add any other text, just the JSON.\n\nEmail Subject: \"{{$json.subject}}\"\nEmail Body: \"{{$json.textAsHtml}}\"",
        "options": {}
      },
      "id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
      "name": "Gemini Classifier",
      "type": "n8n-nodes-base.googleGeminiChat",
      "typeVersion": 1,
      "position": [
        1200,
        200
      ],
      "credentials": {
        "googleGeminiApi": {
          "id": "YOUR_GEMINI_CREDENTIALS_ID",
          "name": "Gemini credentials"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.candidates[0].content.parts[0].text}}",
              "operation": "contains",
              "value2": "DELETE"
            }
          ]
        }
      },
      "id": "b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e",
      "name": "IF Bank Related?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1400,
        200
      ]
    },
